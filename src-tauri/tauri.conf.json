{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ophiuchus",
  "version": "0.1.0-beta.1",
  "identifier": "com.gnosteq.ophiuchus",
  "build": {
    "frontendDist": "../dist-spike"
  },
  "app": {
    "windows": [
      {
        "title": "Ophiuchus",
