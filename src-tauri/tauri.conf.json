{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ophiuchus",
  "version": "0.2.0-beta.1",
  "identifier": "com.gnosteq.ophiuchus",
  "build": {
    "frontendDist": "../dist-view"
  },
  "app": {
    "windows": [
      {
        "title": "Ophiuchus",
        "label": "main",
        "width": 1560,
        "height": 880,
        "minWidth": 480,
        "minHeight": 320,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "maximizable": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ophi-core"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
